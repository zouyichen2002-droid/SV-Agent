# ---- 第三方版权素材：绝不提交 ----
# 音频、视频、分离出的 stem
*.wav
*.mp3
*.m4a
*.flac
*.aac
*.ogg
*.mp4
*.mkv
*.mov

# 带时间轴的歌词（翻唱时是第三方版权内容）
*.lrc
*.srt
*.ass
*.vtt

# 工程与乐谱：SynthV / FL Studio / MIDI 都可能带第三方乐谱
*.svp
*.svpk
*.flp
*.mid
*.midi

# 音色库（如 Windows 自带的 gm.dls）：只在本机读取，绝不复制进仓库
*.dls
*.sf2
*.sf3

# ---- 模型权重 ----
models/
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.ckpt

# ---- 凭据与本机配置 ----
.env
.env.*
!.env.example
config.local.*

# ---- 中间产物 ----
out/
output/
cache/
*.npz
*.npy

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Node ----
node_modules/
dist/
*.log

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
*.bak
